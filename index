                showToast("⚠️ 소비기한이 지난 상품입니다! (초과 등록 가능)");
            } else {
                showToast("사진 분석이 완료되었습니다.");
            }
        }

        function saveAiResult(e) {
            e.preventDefault();
            const dateVal = document.getElementById('ai-date').value;
            const newItem = {
                id: Date.now().toString(),
                name: document.getElementById('ai-name').value,
