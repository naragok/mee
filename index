            if (urgentItems.length > 0) {
                reportHtml += `<div class="my-2 border-t pt-2 font-bold text-amber-600">⚠️ 당일/임박 관리 대상 (${urgentItems.length}개):</div><ul class="list-disc pl-4 space-y-1">`;
                urgentItems.forEach(i => {
                    const diffDays = getDaysUntilExpiry(i.expiryDate);
