        function saveManualResult(e) {
            e.preventDefault();
            const dateVal = document.getElementById('manual-date').value;
            const newItem = {
                id: Date.now().toString(),
                name: document.getElementById('manual-name').value,
                expiryDate: dateVal,
                expiryTime: document.getElementById('manual-time').value,
                category: document.getElementById('manual-category').value,
                quantity: parseInt(document.getElementById('manual-qty').value) || 1,
                barcode: document.getElementById('manual-barcode').value
            };

            items.unshift(newItem);
            renderItems();
            closeManualModal();

            const diff = getDaysUntilExpiry(dateVal);
            if (diff < 0) {
                showToast(`🚨 [기한 초과] '${newItem.name}' 수동 등록 완료.`);
