        function openReportModal() {
            const reportEl = document.getElementById('report-content');
            const now = new Date().toLocaleString('ko-KR');

            const expiredItems = items.filter(i => getDaysUntilExpiry(i.expiryDate) < 0);
            const urgentItems = items.filter(i => {
                const d = getDaysUntilExpiry(i.expiryDate);
                return d >= 0 && d <= 2;
            });

            let reportHtml = `
                <div class="font-bold border-b pb-2 mb-2 text-sm">📋 [세븐일레븐] 근무 교대 소비기한 점검 리포트</div>
                <div><strong>점검 일시:</strong> ${now}</div>
                <div><strong>총 재고 건수:</strong> ${items.length}건</div>
