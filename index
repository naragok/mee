                <div><strong>⚠️ 2일 이내 임박:</strong> <span class="text-red-500 font-bold">${urgentItems.length}건</span></div>
            `;

            if (expiredItems.length > 0) {
                reportHtml += `<div class="my-2 border-t pt-2 font-bold text-red-700">🚨 즉시 매대 철수/폐기 대상 (${expiredItems.length}개):</div><ul class="list-disc pl-4 space-y-1">`;
                expiredItems.forEach(i => {
                    reportHtml += `<li class="text-red-700"><strong>${escapeHtml(i.name)}</strong> - ${i.expiryDate} ${i.expiryTime} [${i.quantity}개 / 기한 초과]</li>`;
