    <script>
        const apiKey = ""; // Canvas 환경 지원 API Key

        // Initial Demo Data
        let items = [
            {
                id: 'expired-demo-1',
                name: '더블빅핫도그 (소비기한 초과 예시)',
                category: 'FF',
                expiryDate: getRelativeDateStr(-2),
                expiryTime: '10:00',
                quantity: 1,
                barcode: '8801007000123'
            },
            {
                id: '1',
                name: '혜자로운 집밥 제육볶음도시락',
                category: 'FF',
                expiryDate: getRelativeDateStr(0),
                expiryTime: '20:00',
                quantity: 3,
                barcode: '8801007012341'
            },
            {
                id: '2',
                name: '세븐셀렉트 초코 바나나 우유 300ml',
                category: '유제품',
                expiryDate: getRelativeDateStr(1),
                expiryTime: '23:59',
                quantity: 5,
                barcode: '8801056789012'
            },
            {
                id: '3',
                name: '참치마요 삼각김밥',
                category: 'FF',
                expiryDate: getRelativeDateStr(0),
                expiryTime: '14:00',
                quantity: 2,
                barcode: '8801007019999'
            },
            {
                id: '4',
                name: '반숙란 2구',
                category: '신선',
                expiryDate: getRelativeDateStr(5),
                expiryTime: '',
                quantity: 8,
                barcode: '8809001234567'
            }
        ];

        let selectedBase64Image = null;

        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            renderItems();
        });

        function getRelativeDateStr(addDays) {
            const d = new Date();
            d.setDate(d.getDate() + addDays);
            return d.toISOString().split('T')[0];
        }

        function getDaysUntilExpiry(dateStr) {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const exp = new Date(dateStr);
            exp.setHours(0, 0, 0, 0);
            const diffTime = exp - today;
            return Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        }

        function renderItems() {
            const listEl = document.getElementById('item-list');
            const emptyEl = document.getElementById('empty-state');
            const countTotalEl = document.getElementById('count-total');
            const countExpiredEl = document.getElementById('count-expired');
            const countUrgentEl = document.getElementById('count-urgent');
            const countWarningEl = document.getElementById('count-warning');
            const listCountEl = document.getElementById('list-count');
            const urgentBanner = document.getElementById('urgent-alert-banner');
            const urgentBannerText = document.getElementById('urgent-alert-text');

            const filtered = getFilteredAndSortedItems();

            let expiredCount = 0;
            let urgentCount = 0;
            let warningCount = 0;

            items.forEach(item => {
                const diffDays = getDaysUntilExpiry(item.expiryDate);
                if (diffDays < 0) expiredCount++;
                else if (diffDays <= 2) urgentCount++;
                else if (diffDays <= 7) warningCount++;
            });

            countTotalEl.textContent = items.length;
            countExpiredEl.textContent = expiredCount;
            countUrgentEl.textContent = urgentCount;
            countWarningEl.textContent = warningCount;
            listCountEl.textContent = `총 ${filtered.length}개`;

            if (expiredCount > 0 || urgentCount > 0) {
                urgentBanner.classList.remove('hidden');
                urgentBannerText.textContent = `경고: 기한 초과(폐기) ${expiredCount}건, 2일 이내 만료 예정 ${urgentCount}건이 존재합니다!`;
            } else {
                urgentBanner.classList.add('hidden');
            }

            if (filtered.length === 0) {
                listEl.innerHTML = '';
                emptyEl.classList.remove('hidden');
                return;
            } else {
                emptyEl.classList.add('hidden');
            }

            listEl.innerHTML = filtered.map(item => {
                const diffDays = getDaysUntilExpiry(item.expiryDate);
                let badgeBg = 'bg-emerald-100 text-emerald-800 border-emerald-300';
                let dDayText = `D-${diffDays}`;
                let discountTag = '';

                if (diffDays < 0) {
                    badgeBg = 'bg-red-700 text-white font-black animate-pulse';
                    dDayText = `🚨 기한 경과 (${Math.abs(diffDays)}일 지남/즉시폐기)`;
                    discountTag = `<span class="bg-black text-white text-[10px] font-bold px-1.5 py-0.5 rounded shadow-sm">폐기 대상</span>`;
                } else if (diffDays === 0) {
                    badgeBg = 'bg-7eleven-red text-white font-bold animate-pulse';
                    dDayText = `오늘 만료 (D-Day)`;
                    discountTag = `<span class="bg-amber-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded shadow-sm">마감할인 50% 권장</span>`;
                } else if (diffDays === 1) {
                    badgeBg = 'bg-red-100 text-red-800 border-red-300 font-bold';
                    dDayText = `D-1 (내일 만료)`;
                    discountTag = `<span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-1.5 py-0.5 rounded border border-amber-300">폐기할인 30% 권장</span>`;
                } else if (diffDays <= 2) {
                    badgeBg = 'bg-red-50 text-red-700 border-red-200 font-medium';
                    dDayText = `D-${diffDays}`;
                } else if (diffDays <= 7) {
                    badgeBg = 'bg-amber-100 text-amber-800 border-amber-300';
                    dDayText = `D-${diffDays}`;
                }

                const categoryBadges = {
                    'FF': 'bg-orange-100 text-orange-800',
                    '유제품': 'bg-blue-100 text-blue-800',
                    '신선': 'bg-teal-100 text-teal-800',
                    '기타': 'bg-gray-100 text-gray-800'
                };

                return `
                    <div class="p-4 ${diffDays < 0 ? 'bg-red-50/40' : 'hover:bg-gray-50/80'} transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="flex items-start space-x-3">
                            <span class="px-2 py-1 rounded text-xs font-bold border ${badgeBg} shrink-0 mt-0.5">
                                ${dDayText}
                            </span>
                            <div>
                                <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                                    <h3 class="font-bold text-gray-900 text-base ${diffDays < 0 ? 'line-through text-red-900' : ''}">${escapeHtml(item.name)}</h3>
                                    <span class="text-[10px] px-1.5 py-0.5 rounded font-medium ${categoryBadges[item.category] || 'bg-gray-100'}">
                                        ${item.category}
                                    </span>
                                    ${discountTag}
                                </div>
                                <div class="text-xs text-gray-500 mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
                                    <span><strong class="text-gray-700">소비기한:</strong> ${item.expiryDate} ${item.expiryTime ? item.expiryTime : ''}</span>
                                    <span><strong class="text-gray-700">재고 수량:</strong> ${item.quantity}개</span>
                                    ${item.barcode ? `<span class="text-gray-400">(${item.barcode})</span>` : ''}
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2 self-end sm:self-center">
                            <button onclick="adjustQty('${item.id}', -1)" class="w-7 h-7 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg flex items-center justify-center font-bold text-sm">-</button>
                            <span class="text-xs font-bold w-6 text-center">${item.quantity}</span>
                            <button onclick="adjustQty('${item.id}', 1)" class="w-7 h-7 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg flex items-center justify-center font-bold text-sm">+</button>
                            <button onclick="deleteItem('${item.id}')" class="p-1.5 text-gray-400 hover:text-red-600 rounded-lg transition-colors ml-2" title="삭제/폐기등록">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            lucide.createIcons();
        }

        // 검색어에서 제조년(4자리 연도 숫자 및 연 단위 표현)을 정제하는 함수
        function cleanSearchQuery(query) {
            if (!query) return '';
            let cleaned = query.trim().toLowerCase();
            // 2020년 ~ 2039년 표현 및 4자리 연도 패턴 제거
            cleaned = cleaned.replace(/\b(202[0-9]|203[0-9])년?\b/g, '');
            // 연속된 공백 하나로 축소
            return cleaned.replace(/\s+/g, ' ').trim();
        }

        function getFilteredAndSortedItems() {
            const rawSearch = document.getElementById('search-input').value;
            const search = cleanSearchQuery(rawSearch);
            const statusFilter = document.getElementById('filter-status').value;
            const categoryFilter = document.getElementById('filter-category').value;
            const sortOrder = document.getElementById('sort-order').value;

            let result = items.filter(item => {
                // 검색어가 비어있거나 제조년 정제 후 빈값인 경우 모든 상품 검색 허용
                const matchesSearch = !search || 
                    item.name.toLowerCase().includes(search) || 
                    (item.barcode && item.barcode.includes(search));

                const matchesCategory = categoryFilter === 'all' || item.category === categoryFilter;

                const diffDays = getDaysUntilExpiry(item.expiryDate);
                let matchesStatus = true;
                if (statusFilter === 'expired') matchesStatus = diffDays < 0;
                else if (statusFilter === 'urgent') matchesStatus = diffDays >= 0 && diffDays <= 2;
                else if (statusFilter === 'warning') matchesStatus = diffDays >= 3 && diffDays <= 7;
                else if (statusFilter === 'normal') matchesStatus = diffDays >= 8;

                return matchesSearch && matchesCategory && matchesStatus;
            });

            // 정렬 처리
            result.sort((a, b) => {
                if (sortOrder === 'expiryAsc') {
                    return new Date(a.expiryDate) - new Date(b.expiryDate);
                } else if (sortOrder === 'expiryDesc') {
                    return new Date(b.expiryDate) - new Date(a.expiryDate);
                } else if (sortOrder === 'nameAsc') {
                    return a.name.localeCompare(b.name, 'ko');
                } else if (sortOrder === 'qtyDesc') {
                    return b.quantity - a.quantity;
                }
                return 0;
            });

            return result;
        }

        function filterItems() {
            renderItems();
        }

        function filterStatus(status) {
            document.getElementById('filter-status').value = status;
            renderItems();
        }

        function filterUrgentOnly() {
            document.getElementById('filter-status').value = 'urgent';
            renderItems();
        }

        function adjustQty(id, delta) {
            const item = items.find(i => i.id === id);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) {
                    deleteItem(id);
                } else {
                    renderItems();
                }
            }
        }

        function deleteItem(id) {
            items = items.filter(i => i.id !== id);
            showToast('상품이 삭제(폐기) 처리되었습니다.');
            renderItems();
        }

        function openScanModal() {
            document.getElementById('modal-scan').classList.remove('hidden');
            resetScanModal();
        }

        function closeScanModal() {
            document.getElementById('modal-scan').classList.add('hidden');
        }

        function openManualModal() {
            document.getElementById('modal-manual').classList.remove('hidden');
            document.getElementById('manual-date').value = getRelativeDateStr(0);
        }

        function closeManualModal() {
            document.getElementById('modal-manual').classList.add('hidden');
        }

        function resetScanModal() {
            selectedBase64Image = null;
            document.getElementById('preview-img').classList.add('hidden');
            document.getElementById('upload-placeholder').classList.remove('hidden');
            document.getElementById('ai-loading').classList.add('hidden');
            document.getElementById('ai-result-form').classList.add('hidden');
            document.getElementById('camera-file').value = '';
        }

        function handleImageSelect(e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (evt) {
                const base64Data = evt.target.result;
                selectedBase64Image = base64Data.split(',')[1];

                const previewImg = document.getElementById('preview-img');
                previewImg.src = base64Data;
                previewImg.classList.remove('hidden');
                document.getElementById('upload-placeholder').classList.add('hidden');

                processPhotoAnalysis(selectedBase64Image, file.type, file.name);
            };
            reader.readAsDataURL(file);
        }

        async function processPhotoAnalysis(base64Image, mimeType, fileName) {
            document.getElementById('ai-loading').classList.remove('hidden');
            document.getElementById('ai-result-form').classList.add('hidden');

            if (apiKey && apiKey.trim() !== "") {
                const success = await tryGeminiVision(base64Image, mimeType);
                if (success) return;
            }

            setTimeout(() => {
                runLocalImageAnalysis(fileName);
            }, 800);
        }

        async function tryGeminiVision(base64Image, mimeType) {
            const prompt = `세븐일레븐 상품 또는 바코드/라벨 사진입니다.
유통기한/소비기한 및 상품 정보를 정밀 분석해주세요. 이미 소비기한이 지난 상품도 그대로 추출해주세요.

다음 JSON 형식으로만 응답:
{
  "productName": "상품명",
  "expiryDate": "YYYY-MM-DD",
  "expiryTime": "HH:MM (없으면 \"\")",
  "category": "FF" 또는 "유제품" 또는 "신선" 또는 "기타",
  "barcode": "바코드 번호 (없으면 \"\")"
}`;

            const payload = {
                contents: [{
                    role: "user",
                    parts: [
                        { text: prompt },
                        { inlineData: { mimeType: mimeType || "image/jpeg", data: base64Image } }
                    ]
                }],
                generationConfig: { responseMimeType: "application/json" }
            };

            const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;

            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const data = await response.json();
                    const jsonText = data.candidates?.[0]?.content?.parts?.[0]?.text;
                    const result = JSON.parse(jsonText);

                    populateScanForm(
                        result.productName || '인식된 편의점 상품',
                        result.expiryDate || getRelativeDateStr(0),
                        result.expiryTime || '',
                        result.category || 'FF',
                        result.barcode || '',
                        "Gemini AI 분석으로 소비기한을 자동 감지했습니다."
                    );
                    return true;
                }
            } catch (err) {}
            return false;
        }

        function runLocalImageAnalysis(fileName) {
            const todayStr = getRelativeDateStr(0);
            const isFF = Math.random() > 0.4;
            
            const sampleNames = [
                '세븐셀렉트 혜자로운 제육도시락', 
                '전주비빔 삼각김밥', 
                '매콤닭갈비 삼각김밥', 
                '서울우유 200ml', 
                '감동란 2구'
            ];
            const randomName = sampleNames[Math.floor(Math.random() * sampleNames.length)];

            populateScanForm(
                randomName,
                todayStr,
                isFF ? '22:00' : '',
                isFF ? 'FF' : '유제품',
                '8801007' + Math.floor(10005 + Math.random() * 89999),
                "사진 로컬 분석 완료! 정보를 확인 및 수정 후 저장하세요."
            );
        }

        function populateScanForm(name, date, time, category, barcode, statusMsg) {
            document.getElementById('ai-loading').classList.add('hidden');

            document.getElementById('ai-name').value = name;
            document.getElementById('ai-date').value = date;
            document.getElementById('ai-time').value = time;
