                });
                reportHtml += `</ul>`;
            }

            if (expiredItems.length === 0 && urgentItems.length === 0) {
                reportHtml += `<div class="text-gray-500 py-2 border-t mt-2">특이사항 없음 (즉시 폐기 및 임박 상품 없음)</div>`;
            }

            reportHtml += `
                <div class="border-t pt-2 mt-2 text-gray-500">
                    * 인수인계 완료 후 POS 폐기 등록 및 서명 바람.
                </div>
            `;

            reportEl.innerHTML = reportHtml;
            document.getElementById('modal-report').classList.remove('hidden');
        }

        function closeReportModal() {
            document.getElementById('modal-report').classList.add('hidden');
        }

        function copyReportText() {
            const reportEl = document.getElementById('report-content');
            const textToCopy = reportEl.innerText;

            const tempInput = document.createElement("textarea");
            tempInput.value = textToCopy;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);

            showToast("인수인계 리포트가 복사되었습니다!");
        }

        function playBeepSound() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.type = 'sine';
                osc.frequency.value = 880;
                gain.gain.value = 0.1;
                osc.start();
                osc.stop(ctx.currentTime + 0.15);
            } catch(e){}
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').textContent = msg;
            toast.classList.remove('opacity-0');
            setTimeout(() => {
                toast.classList.add('opacity-0');
            }, 3000);
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;")
                      .replace(/</g, "&lt;")
                      .replace(/>/g, "&gt;")
                      .replace(/"/g, "&quot;")
                      .replace(/'/g, "&#039;");
        }
